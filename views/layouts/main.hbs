<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#e3b5dd" />
  <title>{{title}}</title>
  <meta name="description" content="Baby shower — Daniel &amp; Lisseth. Abre nuestro libro." />

  {{#if og}}
  <!-- Open Graph: vista previa al compartir el enlace (WhatsApp, Facebook…).
       La imagen es 1200×630 (horizontal): WhatsApp solo muestra la tarjeta
       grande con imágenes apaisadas; con una vertical pone una miniatura. -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:title" content="{{og.title}}" />
  <meta property="og:description" content="{{og.description}}" />
  <meta property="og:image" content="{{og.image}}" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{og.title}}" />
  <meta property="og:url" content="{{og.url}}" />
  <meta name="twitter:card" content="summary_large_image" />
  {{/if}}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&family=Caveat:wght@500;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/style.css" />
</head>
<body{{#if bodyClass}} class="{{bodyClass}}"{{/if}}>
  {{{body}}}
</body>
</html>
