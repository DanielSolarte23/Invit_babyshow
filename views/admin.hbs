<div class="admin-wrap">
  <div class="admin-header">
    <h1>&#128009; Panel de Administraci&oacute;n</h1>
    <p>Baby Shower &mdash; {{event.parents.dadFull}} &amp; {{event.parents.momFull}}</p>
  </div>

  <div class="admin-stats">
    <div class="stat-card">
      <span class="stat-number">{{stats.totalGuests}}</span>
      <span class="stat-label">Confirmaciones</span>
    </div>
    <div class="stat-card">
      <span class="stat-number">{{stats.totalPeople}}</span>
      <span class="stat-label">Personas totales</span>
    </div>
    <div class="stat-card stat-wish">
      <span class="stat-number">{{stats.totalWishes}}</span>
      <span class="stat-label">&#128151; Deseos escritos</span>
    </div>
  </div>

  {{#if guests.length}}
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Tel&eacute;fono</th>
          <th>Asist.</th>
          <th>Deseo para la beb&eacute;</th>
          <th>Confirm&oacute; con</th>
          <th>Fecha</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each guests}}
        <tr data-id="{{_id}}">
          <td class="td-name">{{name}}</td>
          <td>{{phone}}</td>
          <td class="td-center">{{numberOfGuests}}</td>
          <td class="td-wish">
            {{#if hasWish}}<span class="wish-quote">{{wish}}</span>{{else}}<span class="td-empty">&mdash;</span>{{/if}}
          </td>
          <td>{{confirmedWithDisplay}}</td>
          <td class="td-date">{{getFormattedDate}}</td>
          <td>
            <button class="btn-delete" onclick="deleteGuest('{{_id}}', this)">&#128465;</button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="admin-empty">A&uacute;n no hay confirmaciones.</p>
  {{/if}}
</div>

<script>
async function deleteGuest(id, btn) {
  if (!confirm('¿Eliminar este invitado?')) return;
  btn.disabled = true;
  try {
    const res = await fetch('/admin/guests/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
      btn.closest('tr').remove();
    } else {
      alert('Error al eliminar');
      btn.disabled = false;
    }
  } catch {
    alert('Error de conexión');
    btn.disabled = false;
  }
}
</script>
