<!-- Instrumental: main.js lo descarga y lo toca por Web Audio; este <audio>
     es solo el respaldo (preload="none" para no bajarlo dos veces) -->
<audio id="bg-audio" loop preload="none">
  <source src="/audio/instrumental.mp3" type="audio/mpeg" />
</audio>

<!-- ═══════════════════════════════════════════════════════════════
     INTRO — toque inicial (permiso de audio) + video de Pan
═══════════════════════════════════════════════════════════════ -->
<div id="intro" class="intro">
  <div id="intro-gate" class="intro-gate">
    <div class="dragon-balls" aria-hidden="true">
      <span class="db db-1"></span><span class="db db-2"></span><span class="db db-3"></span>
      <span class="db db-4"></span><span class="db db-5"></span><span class="db db-6"></span>
      <span class="db db-7"></span>
    </div>
    <p class="intro-eyebrow">Baby Shower</p>
    <button type="button" id="btn-start" class="btn-open">TOCA PARA COMENZAR</button>
    <p class="intro-hint">Sube el volumen &#128266;</p>
  </div>

  <video id="intro-video" class="intro-video" src="/video/intro.mp4" playsinline preload="auto"></video>

  <!-- Marco tipo cuadro alrededor del video (solo decorativo) -->
  <div class="intro-frame" aria-hidden="true">
    <span class="frame-star fs-tl star-yellow"><svg><use href="#star-shape" /></svg></span>
    <span class="frame-star fs-tr star-blue"><svg><use href="#star-shape" /></svg></span>
    <span class="frame-star fs-bl star-pink"><svg><use href="#star-shape" /></svg></span>
    <span class="frame-star fs-br star-yellow"><svg><use href="#star-shape" /></svg></span>
  </div>
  <button type="button" id="intro-skip" class="intro-skip" hidden>Saltar &rsaquo;</button>
</div>

<!-- Forma de estrella pastel (puntas redondeadas por el trazo grueso), reusada
     por el cielo y por las chispas de entrada del libro -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="star-shape" viewBox="0 0 100 100">
    <path d="M50 12 L61.2 36.6 L88 39.6 L68.1 57.9 L73.5 84.4 L50 71 L26.5 84.4 L31.9 57.9 L12 39.6 L38.8 36.6 Z"
          fill="currentColor" stroke="currentColor" stroke-width="14" stroke-linejoin="round" />
    <path d="M50 12 L61.2 36.6 L88 39.6 L68.1 57.9 L73.5 84.4 L50 71 L26.5 84.4 L31.9 57.9 L12 39.6 L38.8 36.6 Z"
          fill="#fff" opacity=".35" transform="translate(16 12) scale(.6)" />
  </symbol>
</svg>

<!-- Fondo: cielo pastel + nubes + estrellas (paleta de la animación de Pan) -->
<div class="sky" aria-hidden="true">
  <span class="cloud cloud-1"></span>
  <span class="cloud cloud-2"></span>
  <span class="cloud cloud-3"></span>

  <span class="star star-1 star-yellow"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-2 star-blue"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-3 star-pink"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-4 star-yellow"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-5 star-blue"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-6 star-yellow"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-7 star-pink"><svg><use href="#star-shape" /></svg></span>
  <span class="star star-8 star-yellow"><svg><use href="#star-shape" /></svg></span>

  <span class="spark spark-1"></span>
  <span class="spark spark-2"></span>
  <span class="spark spark-3"></span>
  <span class="spark spark-4"></span>
  <span class="spark spark-5"></span>
  <span class="spark spark-6"></span>
  <span class="spark spark-7"></span>
  <span class="spark spark-8"></span>
</div>

<!-- Chispas al aparecer el libro (main.js las crea y las borra) -->
<div id="burst" class="burst" aria-hidden="true"></div>

<!-- Toast -->
<div id="toast-message" class="toast" role="status" aria-live="polite"></div>

<!-- Control de música -->
<button id="music-toggle" class="music-toggle is-off" aria-label="Activar o silenciar música">
  <span class="music-icon">&#9834;</span>
</button>

<!-- ═══════════════════════════════════════════════════════════════
     EL LIBRO
═══════════════════════════════════════════════════════════════ -->
<main class="stage">

  <div class="book" id="book">
    <div class="book-spine" aria-hidden="true"></div>

    <!-- ──────────────── PÁGINA 0 · PORTADA ──────────────── -->
    <article class="leaf cover-peek" data-page="0">
      <div class="face face-front cover">
        <div class="cover-glow" aria-hidden="true"></div>

        <div class="dragon-balls" aria-hidden="true">
          <span class="db db-1"></span><span class="db db-2"></span><span class="db db-3"></span>
          <span class="db db-4"></span><span class="db db-5"></span><span class="db db-6"></span>
          <span class="db db-7"></span>
        </div>

        <p class="cover-eyebrow">Baby Shower</p>
        <h1 class="cover-title">UNA NUEVA<br />SAIYAJIN<br />EST&Aacute; POR LLEGAR</h1>

        <div class="cover-art">
          <img src="/img/bebe.png" alt="" class="cover-img" />
          <div class="cover-img-fallback">&#128118;</div>
        </div>

        {{#if event.baby.hasName}}
          <p class="cover-baby">{{event.baby.name}}</p>
        {{/if}}

        <p class="cover-parents">{{event.parents.dadFull}} &amp; {{event.parents.momFull}}</p>

        <button id="btn-open" class="btn-open">ABRIR EL LIBRO</button>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

    <!-- ──────────────── PÁGINA 1 · FRASE PARA LA BEBÉ ──────────────── -->
    <article class="leaf" data-page="1">
      <div class="face face-front">
        <div class="page-scroll">
          <p class="chapter">{{event.phrase.eyebrow}}</p>
          <h2 class="page-title">{{event.phrase.title}}</h2>
          <div class="rule" aria-hidden="true"></div>

          <div class="phrase">
            {{#each event.phrase.lines}}
              <p class="phrase-line">{{this}}</p>
            {{/each}}
          </div>

          <p class="phrase-to">Para {{event.baby.display}} &#128151;</p>
        </div>
        <span class="page-num">1</span>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

    <!-- ──────────────── PÁGINA 2 · DÓNDE ──────────────── -->
    <article class="leaf" data-page="2">
      <div class="face face-front">
        <div class="page-scroll">
          <p class="chapter">Cap&iacute;tulo II</p>
          <h2 class="page-title">&iquest;D&oacute;nde?</h2>
          <div class="rule" aria-hidden="true"></div>

          {{#if event.where.place}}
            <p class="where-place">{{event.where.place}}</p>
            <p class="where-address">{{event.where.address}}</p>
          {{else}}
            {{!-- Sin nombre de lugar (casa familiar): la dirección pasa a ser el título --}}
            <p class="where-place">{{event.where.address}}</p>
          {{/if}}
          <p class="where-city">{{event.where.city}}</p>

          <div class="map-wrap">
            <iframe
              src="{{{mapSrc}}}"
              width="100%" height="190" style="border:0;"
              allowfullscreen="" loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicaci&oacute;n del evento"></iframe>
          </div>
        </div>
        <span class="page-num">2</span>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

    <!-- ──────────────── PÁGINA 3 · CUÁNDO + CÓMO VENIR ──────────────── -->
    <article class="leaf" data-page="3">
      <div class="face face-front">
        <div class="page-scroll">
          <p class="chapter">Cap&iacute;tulo III</p>

          <div class="split-half">
            <h2 class="split-title">&iquest;Cu&aacute;ndo?</h2>
            <div class="rule rule-sm" aria-hidden="true"></div>

            <p class="page-lead">{{event.when.weekday}}</p>

            <div class="when-grid">
              <div class="when-item">
                <span class="when-label">D&Iacute;A</span>
                <span class="when-value">{{event.when.day}}</span>
              </div>
              <span class="when-sep" aria-hidden="true"></span>
              <div class="when-item">
                <span class="when-label">MES</span>
                <span class="when-value">{{event.when.month}}</span>
              </div>
              <span class="when-sep" aria-hidden="true"></span>
              <div class="when-item">
                <span class="when-label">HORA</span>
                <span class="when-value">{{event.when.time}}</span>
              </div>
            </div>
          </div>

          <div class="when-art">
            <img src="/img/bebe-tetero.png" alt="" class="when-img" />
          </div>
        </div>
        <span class="page-num">3</span>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

    <!-- ──────────────── PÁGINA 4 · ECOGRAFÍA ──────────────── -->
    <article class="leaf" data-page="4">
      <div class="face face-front">
        <div class="page-scroll">
          <p class="chapter">Cap&iacute;tulo IV</p>
          <h2 class="page-title">Tu primera foto</h2>
          <div class="rule" aria-hidden="true"></div>

          <div class="sono-wrap">
            <img src="/img/detalle.png" alt="" class="page-sticker sticker-tl" />
            <img src="/img/detalle.png" alt="" class="page-sticker sticker-br" />
            <div class="sono-frame">
              <img src="/img/ecografia.jpg" alt="" class="sono-img" />
              <div class="sono-fallback">&#128151;</div>
            </div>
          </div>

          <p class="sono-caption">As&iacute; te vimos por primera vez, {{event.baby.display}}</p>
        </div>
        <span class="page-num">4</span>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

    <!-- ──────────────── PÁGINA 5 · CARTA DE LOS PADRES ──────────────── -->
    <article class="leaf" data-page="5">
      <div class="face face-front letter-page">
        <div class="page-scroll">
          <p class="chapter">{{event.letter.eyebrow}}</p>
          <h2 class="page-title">{{event.letter.title}}</h2>
          <div class="rule" aria-hidden="true"></div>

          <div class="letter">
            {{#each event.letter.paragraphs}}
              <p class="letter-p">{{this}}</p>
            {{/each}}
          </div>

          <p class="letter-sign">{{event.letter.signature}}</p>
          <p class="letter-names">{{event.parents.dad}} &amp; {{event.parents.mom}}</p>
          <p class="letter-heart" aria-hidden="true">&#128151;</p>
        </div>
        <span class="page-num">5</span>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

    <!-- ──────────────── PÁGINA 6 · CONFIRMACIÓN ──────────────── -->
    <article class="leaf" data-page="6">
      <div class="face face-front rsvp-page">
        <div class="page-scroll">
          <p class="chapter">Cap&iacute;tulo VI</p>
          <h2 class="page-title">{{event.rsvp.title}}</h2>
          <div class="rule" aria-hidden="true"></div>

          <p class="rsvp-desc">{{event.rsvp.description}}</p>

          <form id="confirm-form" onsubmit="return false;" novalidate>
            <div class="form-group">
              <label for="guest-name">Nombre completo *</label>
              <input type="text" id="guest-name" autocomplete="name" placeholder="&iquest;C&oacute;mo te llamas?" required />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="guest-phone">Tel&eacute;fono <span class="label-opt">(opcional)</span></label>
                <input type="tel" id="guest-phone" autocomplete="tel" placeholder="3001234567" />
              </div>
              <div class="form-group form-group-sm">
                <label for="guest-count">Asistentes</label>
                <select id="guest-count">
                  {{#each guestOptions}}<option value="{{this}}">{{this}}</option>{{/each}}
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="guest-wish">Un deseo para {{event.baby.display}} <span class="label-opt">(opcional)</span></label>
              <textarea id="guest-wish" rows="3" maxlength="400"
                placeholder="Escr&iacute;bele algo bonito, lo guardaremos para ella..."></textarea>
              <span id="wish-count" class="wish-count">0 / 400</span>
            </div>

            <p id="form-error" class="form-error" hidden></p>

            <p class="rsvp-with">&iquest;Con qui&eacute;n confirmas?</p>
            <div class="confirm-btns">
              <button type="button" class="btn-confirm btn-dad" data-parent="daniel">
                &#128241; Pap&aacute; {{event.parents.dad}}
              </button>
              <button type="button" class="btn-confirm btn-mom" data-parent="lisseth">
                &#128241; Mam&aacute; {{event.parents.mom}}
              </button>
            </div>
          </form>

          <!-- Estado: ya confirmado -->
          <div id="rsvp-done" class="rsvp-done" hidden>
            <p class="rsvp-done-icon">&#128009;</p>
            <h3 class="rsvp-done-title">&iexcl;Confirmaci&oacute;n guardada!</h3>
            <p class="rsvp-done-text">Gracias por acompa&ntilde;arnos en este cap&iacute;tulo.</p>
            <a id="rsvp-wa-link" href="#" target="_blank" rel="noopener" class="btn-wa">
              Enviar mensaje por WhatsApp
            </a>
            <button type="button" id="rsvp-again" class="btn-again">Confirmar a alguien m&aacute;s</button>
          </div>

          <div class="counter">
            <div class="counter-item">
              <span id="total-count" class="counter-num">0</span>
              <span class="counter-label">confirmaciones</span>
            </div>
            <span class="counter-sep" aria-hidden="true"></span>
            <div class="counter-item">
              <span id="total-people" class="counter-num">0</span>
              <span class="counter-label">personas</span>
            </div>
            <span class="counter-sep" aria-hidden="true"></span>
            <div class="counter-item">
              <span id="total-wishes" class="counter-num">0</span>
              <span class="counter-label">deseos</span>
            </div>
          </div>

          <div class="closing">
            <img src="/img/Dragon.png" alt="" class="closing-dragon" />
            <p class="closing-text">Te esperamos</p>
            <p class="closing-sub">Con amor, {{event.parents.dad}} &amp; {{event.parents.mom}}</p>
          </div>
        </div>
        <span class="page-num">6</span>
      </div>
      <div class="face face-back"><div class="back-mark" aria-hidden="true"></div></div>
    </article>

  </div><!-- /book -->

  <!-- ── Navegación ── -->
  <button id="nav-prev" class="nav-arrow nav-prev" aria-label="P&aacute;gina anterior">&lsaquo;</button>
  <button id="nav-next" class="nav-arrow nav-next" aria-label="P&aacute;gina siguiente">&rsaquo;</button>

  <nav id="page-dots" class="dots" aria-label="P&aacute;ginas del libro"></nav>
  <p id="swipe-hint" class="swipe-hint">Desliza o toca la flecha para avanzar</p>

</main>

<!-- ═══════════════════════════════════════════════════════════════
     ESCENA FINAL — el libro se cierra
═══════════════════════════════════════════════════════════════ -->
<div id="book-closing" class="book-closing" hidden>
  <div class="closing-scene">
    <div class="dragon-balls" aria-hidden="true">
      <span class="db db-1"></span><span class="db db-2"></span><span class="db db-3"></span>
      <span class="db db-4"></span><span class="db db-5"></span><span class="db db-6"></span>
      <span class="db db-7"></span>
    </div>
    <button type="button" id="book-reopen" class="closed-book" aria-label="Volver a abrir el libro">
      <span class="closed-book-spine" aria-hidden="true"></span>
      <span class="closed-book-ribbon" aria-hidden="true"></span>
    </button>
    <p class="closing-final-text">Te esperamos</p>
    <p class="closing-final-sub">Con amor, {{event.parents.dad}} &amp; {{event.parents.mom}}</p>
    <button type="button" id="book-reopen-link" class="btn-again">&lsaquo; Volver al libro</button>
  </div>
</div>

<script src="/js/main.js"></script>
