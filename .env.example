PORT=3001
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/babyshower

# Números de WhatsApp con código de país, sin + ni espacios (ej: 573001234567)
WHATSAPP_DANIEL=573001234567
WHATSAPP_LISSETH=573009876543

PARENT_DAD_NAME=Daniel
PARENT_MOM_NAME=Lisseth

# Nombre de la bebé (aparece en toda la invitación)
BABY_NAME=

# URL pública (opcional). Si se omite se usa el host de la petición.
# Sirve para la vista previa al compartir en WhatsApp (og:image absoluta).
SITE_URL=
